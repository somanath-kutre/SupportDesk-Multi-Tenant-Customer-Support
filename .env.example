# ---- Django ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database: "sqlite" (quick start) or "mysql" ----
DB_ENGINE=mysql
DB_NAME=supportdesk
DB_USER=supportdesk
DB_PASSWORD=supportdesk
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- Redis (leave empty to run without Redis: in-memory cache/channels, eager Celery) ----
REDIS_URL=

# ---- Email (console backend prints emails in the terminal) ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=support@supportdesk.local

# ---- App settings ----
LOG_LEVEL=INFO
MAX_ATTACHMENT_MB=5
AUTO_CLOSE_RESOLVED_DAYS=7
REPORT_CACHE_SECONDS=60
